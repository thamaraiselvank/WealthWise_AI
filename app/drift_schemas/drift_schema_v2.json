    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL, \"age\" INTEGER NOT NULL, \"monthly_income\" REAL NOT NULL, \"monthly_expenses\" REAL NOT NULL, \"monthly_emi\" REAL NOT NULL DEFAULT 0.0, \"savings\" REAL NOT NULL DEFAULT 0.0, \"investments\" REAL NOT NULL DEFAULT 0.0, \"loan_outstanding\" REAL NOT NULL DEFAULT 0.0, \"dependents\" INTEGER NOT NULL DEFAULT 0, \"has_health_insurance\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_health_insurance\" IN (0, 1)), \"has_term_insurance\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_term_insurance\" IN (0, 1)), \"expense_breakdown\" TEXT NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goals\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"today_cost\" REAL NOT NULL, \"years\" REAL NOT NULL, \"already_saved\" REAL NOT NULL DEFAULT 0.0, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
