<?xml version="1.0" encoding="utf-8"?>
<!-- Financial data is encrypted with a device-bound key, so it must never be
     backed up to the cloud or copied to another device (it would be unreadable
     there, and it is private). Android 12+ rules. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
